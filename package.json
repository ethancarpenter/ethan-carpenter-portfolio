{
  "name": "ethan-carpenter-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive retro pixel-art cafe developer portfolio for ethancarpenter.dev",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/test.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config worker/wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config worker/wrangler.toml"
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "oxlint": "^1.0.0",
    "tsx": "^4.23.13",
    "typescript": "~5.7.3",
    "vite": "^6.3.5",
    "wrangler": "~4.86.0"
  }
}
